# Browser-safe Supabase project URL (http://127.0.0.1:54321 locally or https://PROJECT.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe Supabase publishable/anon-compatible key. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase service-role key for deletion and tightly authorized moderation routes.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin with protocol and no trailing slash, e.g. https://app.example.com.
APP_URL=
# Optional hosted monitoring endpoint/DSN. Leave empty to disable remote monitoring.
MONITORING_DSN=
# Optional durable rate-limit provider URL/token for edge login throttling. Database action limits remain active.
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
# Owner-supplied legal/support fields. Do not launch with these blank.
LEGAL_OWNER_NAME=
SUPPORT_CONTACT=
PRIVACY_CONTACT=
